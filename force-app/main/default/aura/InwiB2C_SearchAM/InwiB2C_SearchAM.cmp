<aura:component access="global" implements="lightning:utilityItem">
    <!-- Removed unnecessary attributes -->

    <lightning:messageChannel type="CTIMessageChannel__c"
                              onMessage="{!c.handleCTIMessage}" scope="APPLICATION"/>

    <aura:handler name="init" value="{!this}" action="{!c.handleInit}" />

    <lightning:workspaceAPI aura:id="workspace" />
    <lightning:utilityBarAPI aura:id="utilityBarAPI" />

    <c:inwiAuraPubsub oninteractionChange="{!c.updateInteraction}" />
</aura:component>